# Production / Neon (Postgres) — do not use for local SQLite work
#
# Set these on Render (and never commit real secrets).

NODE_ENV=production
PORT=10000
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
JWT_SECRET="replace-with-long-random-string"
# Comma-separated if multiple frontends:
CORS_ORIGIN="https://your-app.vercel.app"
